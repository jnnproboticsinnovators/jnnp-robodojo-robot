<?xml version="1.0"?>
<robot name="jnnp_robodojo_robot">
  <!-- Frames: base_footprint on the ground; base_link at wheel-axle height, robot centre.
       ROS convention: +X forward, +Y left, +Z up. Meshes are rotated from the CAD frame. -->
  <link name="base_footprint" />
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.0425" rpy="0 0 0" />
  </joint>
  <!-- Chassis -->
  <link name="base_link">
    <visual>
      <origin xyz="-0.1513 0.1259 -0.0456" rpy="0 0 -1.5708" />
      <geometry>
        <mesh filename="package://jnnp_robodojo_robot/meshes/combinationofchassis.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="combinationofchassis_mat">
        <color rgba="0.2 0.4 0.8 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="-0.0016 0.0012 -0.0023" rpy="0 0 0" />
      <geometry>
        <box size="0.2751 0.2859 0.0588" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.0016 0.0012 -0.0023" rpy="0 0 0" />
      <mass value="1.2" />
      <inertia ixx="0.00851962" ixy="0" ixz="0" iyy="0.00791375" iyz="0" izz="0.0157419" />
    </inertial>
  </link>
  <!-- Fixed body parts -->
  <link name="front_cabin_link">
    <visual>
      <origin xyz="-0.1513 0.1259 -0.0456" rpy="0 0 -1.5708" />
      <geometry>
        <mesh filename="package://jnnp_robodojo_robot/meshes/frontcabin.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="frontcabin_mat">
        <color rgba="0.95 0.75 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.0819 0.0004 0.0788" rpy="0 0 0" />
      <geometry>
        <box size="0.1025 0.2750 0.1132" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0819 0.0004 0.0788" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.00221098" ixy="0" ixz="0" iyy="0.000583012" iyz="0" izz="0.00215328" />
    </inertial>
  </link>
  <joint name="front_cabin_joint" type="fixed">
    <parent link="base_link" />
    <child link="front_cabin_link" />
    <origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0" />
  </joint>
  <link name="wheel_holder_2_link">
    <visual>
      <origin xyz="-0.1513 0.1259 -0.0456" rpy="0 0 -1.5708" />
      <geometry>
        <mesh filename="package://jnnp_robodojo_robot/meshes/wheelholder2.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="wheelholder2_mat">
        <color rgba="0.6 0.6 0.6 1" />
      </material>
    </visual>
    <inertial>
      <origin xyz="-0.0753 0.1324 -0.0036" rpy="0 0 0" />
      <mass value="0.03" />
      <inertia ixx="6.3125e-06" ixy="0" ixz="0" iyy="4.225e-05" iyz="0" izz="3.60625e-05" />
    </inertial>
  </link>
  <joint name="wheel_holder_2_joint" type="fixed">
    <parent link="base_link" />
    <child link="wheel_holder_2_link" />
    <origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0" />
  </joint>
  <link name="wheel_holder_001_link">
    <visual>
      <origin xyz="-0.1513 0.1259 -0.0456" rpy="0 0 -1.5708" />
      <geometry>
        <mesh filename="package://jnnp_robodojo_robot/meshes/wheelholder001.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="wheelholder001_mat">
        <color rgba="0.6 0.6 0.6 1" />
      </material>
    </visual>
    <inertial>
      <origin xyz="-0.0753 -0.1256 -0.0026" rpy="0 0 0" />
      <mass value="0.03" />
      <inertia ixx="6.3125e-06" ixy="0" ixz="0" iyy="4.225e-05" iyz="0" izz="3.60625e-05" />
    </inertial>
  </link>
  <joint name="wheel_holder_001_joint" type="fixed">
    <parent link="base_link" />
    <child link="wheel_holder_001_link" />
    <origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0" />
  </joint>
  <link name="wheel_holder_002_link">
    <visual>
      <origin xyz="-0.1513 0.1259 -0.0456" rpy="0 0 -1.5708" />
      <geometry>
        <mesh filename="package://jnnp_robodojo_robot/meshes/wheelholder002.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="wheelholder002_mat">
        <color rgba="0.6 0.6 0.6 1" />
      </material>
    </visual>
    <inertial>
      <origin xyz="0.0747 0.1304 -0.0046" rpy="0 0 0" />
      <mass value="0.03" />
      <inertia ixx="6.3125e-06" ixy="0" ixz="0" iyy="4.225e-05" iyz="0" izz="3.60625e-05" />
    </inertial>
  </link>
  <joint name="wheel_holder_002_joint" type="fixed">
    <parent link="base_link" />
    <child link="wheel_holder_002_link" />
    <origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0" />
  </joint>
  <link name="motor_1_link">
    <visual>
      <origin xyz="-0.1513 0.1259 -0.0456" rpy="0 0 -1.5708" />
      <geometry>
        <mesh filename="package://jnnp_robodojo_robot/meshes/dcgearmotor1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="dcgearmotor1_mat">
        <color rgba="0.85 0.55 0.1 1" />
      </material>
    </visual>
    <inertial>
      <origin xyz="0.0758 -0.1410 -0.0010" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="2.95327e-05" ixy="0" ixz="0" iyy="1.57123e-05" iyz="0" izz="2.90211e-05" />
    </inertial>
  </link>
  <joint name="motor_1_joint" type="fixed">
    <parent link="base_link" />
    <child link="motor_1_link" />
    <origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0" />
  </joint>
  <link name="motor_2_link">
    <visual>
      <origin xyz="-0.1513 0.1259 -0.0456" rpy="0 0 -1.5708" />
      <geometry>
        <mesh filename="package://jnnp_robodojo_robot/meshes/dcgearmotor2.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="dcgearmotor2_mat">
        <color rgba="0.85 0.55 0.1 1" />
      </material>
    </visual>
    <inertial>
      <origin xyz="-0.0750 -0.1400 0.0005" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="2.87521e-05" ixy="0" ixz="0" iyy="1.54053e-05" iyz="0" izz="2.91574e-05" />
    </inertial>
  </link>
  <joint name="motor_2_joint" type="fixed">
    <parent link="base_link" />
    <child link="motor_2_link" />
    <origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0" />
  </joint>
  <link name="motor_3_link">
    <visual>
      <origin xyz="-0.1513 0.1259 -0.0456" rpy="0 0 -1.5708" />
      <geometry>
        <mesh filename="package://jnnp_robodojo_robot/meshes/dcgearmotor3.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="dcgearmotor3_mat">
        <color rgba="0.85 0.55 0.1 1" />
      </material>
    </visual>
    <inertial>
      <origin xyz="-0.0760 0.1443 -0.0001" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="2.83333e-05" ixy="0" ixz="0" iyy="1.49501e-05" iyz="0" izz="2.82834e-05" />
    </inertial>
  </link>
  <joint name="motor_3_joint" type="fixed">
    <parent link="base_link" />
    <child link="motor_3_link" />
    <origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0" />
  </joint>
  <link name="motor_4_link">
    <visual>
      <origin xyz="-0.1513 0.1259 -0.0456" rpy="0 0 -1.5708" />
      <geometry>
        <mesh filename="package://jnnp_robodojo_robot/meshes/dcgearmotor4.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="dcgearmotor4_mat">
        <color rgba="0.85 0.55 0.1 1" />
      </material>
    </visual>
    <inertial>
      <origin xyz="0.0772 0.1418 0.0004" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="2.87521e-05" ixy="0" ixz="0" iyy="1.54053e-05" iyz="0" izz="2.91574e-05" />
    </inertial>
  </link>
  <joint name="motor_4_joint" type="fixed">
    <parent link="base_link" />
    <child link="motor_4_link" />
    <origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0" />
  </joint>
  <!-- Sensors (frame at sensor centre, X forward) -->
  <link name="rplidar_link">
    <visual>
      <origin xyz="-0.2099 0.1273 -0.2018" rpy="0 0 -1.5708" />
      <geometry>
        <mesh filename="package://jnnp_robodojo_robot/meshes/lidar.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="lidar_mat">
        <color rgba="0.15 0.15 0.15 1" />
      </material>
    </visual>
    <inertial>
      <origin xyz="-0.0001 0.0000 -0.0000" rpy="0 0 0" />
      <mass value="0.17" />
      <inertia ixx="0.000120625" ixy="0" ixz="0" iyy="0.000179664" iyz="0" izz="0.000209201" />
    </inertial>
  </link>
  <joint name="rplidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="rplidar_link" />
    <origin xyz="0.0586 -0.0014 0.1562" rpy="0 0 0" />
  </joint>
  <link name="camera_link">
    <visual>
      <origin xyz="-0.2648 0.1297 -0.1941" rpy="0 0 -1.5708" />
      <geometry>
        <mesh filename="package://jnnp_robodojo_robot/meshes/cameramodule3.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="cameramodule3_mat">
        <color rgba="0.1 0.6 0.3 1" />
      </material>
    </visual>
    <inertial>
      <origin xyz="0.0000 0.0000 0.0001" rpy="0 0 0" />
      <mass value="0.01" />
      <inertia ixx="1.23254e-06" ixy="0" ixz="0" iyy="8.29417e-07" iyz="0" izz="6.89142e-07" />
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="front_cabin_link" />
    <child link="camera_link" />
    <origin xyz="0.1135 -0.0038 0.1485" rpy="0 0 0" />
  </joint>
  <!-- Back cabin (dump bed) on a hinge at the rear top edge of the chassis -->
  <link name="back_cabin_link">
    <visual>
      <origin xyz="-0.0140 0.1220 -0.0720" rpy="0 0 -1.5708" />
      <geometry>
        <mesh filename="package://jnnp_robodojo_robot/meshes/backcabin.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="backcabin_mat">
        <color rgba="0.95 0.75 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.0603 0.0001 0.0800" rpy="0 0 0" />
      <geometry>
        <box size="0.1204 0.2802 0.1600" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0603 0.0001 0.0800" rpy="0 0 0" />
      <mass value="0.4" />
      <inertia ixx="0.0034704" ixy="0" ixz="0" iyy="0.00133654" iyz="0" izz="0.00310027" />
    </inertial>
  </link>
  <joint name="back_cabin_joint" type="revolute">
    <parent link="base_link" />
    <child link="back_cabin_link" />
    <origin xyz="-0.1373 0.0039 0.0264" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="0.0" upper="0.785" effort="20.0" velocity="1.0" />
    <dynamics damping="0.5" friction="0.1" />
  </joint>
  <!-- Wheels (axis = +Y; positive spin drives forward) -->
  <link name="wheel_1_link">
    <!-- front right -->
    <visual>
      <origin xyz="-0.2270 0.3114 -0.0451" rpy="0 0 -1.5708" />
      <geometry>
        <mesh filename="package://jnnp_robodojo_robot/meshes/wheel1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="wheel1_mat">
        <color rgba="0.1 0.1 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.0425" length="0.038" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0" />
      <mass value="0.08" />
      <inertia ixx="4.57517e-05" ixy="0" ixz="0" iyy="7.225e-05" iyz="0" izz="4.57517e-05" />
    </inertial>
  </link>
  <joint name="wheel_1_joint" type="continuous">
    <parent link="motor_1_link" />
    <child link="wheel_1_link" />
    <origin xyz="0.0765 -0.1855 0.0000" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0.0" />
  </joint>
  <link name="wheel_2_link">
    <!-- rear right -->
    <visual>
      <origin xyz="-0.0759 0.3094 -0.0461" rpy="0 0 -1.5708" />
      <geometry>
        <mesh filename="package://jnnp_robodojo_robot/meshes/wheel2.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="wheel2_mat">
        <color rgba="0.1 0.1 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.0425" length="0.038" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0" />
      <mass value="0.08" />
      <inertia ixx="4.57517e-05" ixy="0" ixz="0" iyy="7.225e-05" iyz="0" izz="4.57517e-05" />
    </inertial>
  </link>
  <joint name="wheel_2_joint" type="continuous">
    <parent link="motor_2_link" />
    <child link="wheel_2_link" />
    <origin xyz="-0.0765 -0.1855 0.0000" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0.0" />
  </joint>
  <link name="wheel_3_link">
    <!-- rear left -->
    <visual>
      <origin xyz="-0.0754 -0.0599 -0.0455" rpy="0 0 -1.5708" />
      <geometry>
        <mesh filename="package://jnnp_robodojo_robot/meshes/wheel3.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="wheel3_mat">
        <color rgba="0.1 0.1 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.0425" length="0.038" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0" />
      <mass value="0.08" />
      <inertia ixx="4.57517e-05" ixy="0" ixz="0" iyy="7.225e-05" iyz="0" izz="4.57517e-05" />
    </inertial>
  </link>
  <joint name="wheel_3_joint" type="continuous">
    <parent link="motor_3_link" />
    <child link="wheel_3_link" />
    <origin xyz="-0.0765 0.1855 0.0000" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0.0" />
  </joint>
  <link name="wheel_4_link">
    <!-- front left -->
    <visual>
      <origin xyz="-0.2289 -0.0594 -0.0460" rpy="0 0 -1.5708" />
      <geometry>
        <mesh filename="package://jnnp_robodojo_robot/meshes/wheel4.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="wheel4_mat">
        <color rgba="0.1 0.1 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.0425" length="0.038" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0" />
      <mass value="0.08" />
      <inertia ixx="4.57517e-05" ixy="0" ixz="0" iyy="7.225e-05" iyz="0" izz="4.57517e-05" />
    </inertial>
  </link>
  <joint name="wheel_4_joint" type="continuous">
    <parent link="motor_4_link" />
    <child link="wheel_4_link" />
    <origin xyz="0.0765 0.1855 0.0000" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0.0" />
  </joint>
  <!-- ================= GAZEBO (Harmonic) ================= -->
  <gazebo>
    <!-- Skid-steer drive: /cmd_vel in, /odom + odom->base_footprint TF out -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_3_joint</left_joint>
      <left_joint>wheel_4_joint</left_joint>
      <right_joint>wheel_1_joint</right_joint>
      <right_joint>wheel_2_joint</right_joint>
      <wheel_separation>0.371</wheel_separation>
      <wheel_radius>0.0425</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <!-- Publishes wheel + back cabin joint angles on /joint_states -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>
  <!-- RPLidar A1-like 2D lidar: 360 samples, 10 Hz, 12 m.
       min range 0.20 m so the beam ignores the robot's own camera and back cabin. -->
  <gazebo reference="rplidar_link">
    <sensor name="rplidar" type="gpu_lidar">
      <gz_frame_id>rplidar_link</gz_frame_id>
      <topic>scan</topic>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.20</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>
  <!-- Back cabin dump control: publish the angle (rad) on /dump_cmd -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>back_cabin_joint</joint_name>
      <topic>dump_cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>2.0</p_gain>
      <cmd_max>0.8</cmd_max>
      <cmd_min>-0.8</cmd_min>
    </plugin>
  </gazebo>
  <!-- Pi Camera Module 3 (66 deg wide), 640x480 at 15 fps, looking forward from camera_link -->
  <gazebo reference="camera_link">
    <sensor name="pi_camera" type="camera">
      <gz_frame_id>camera_link</gz_frame_id>
      <topic>camera/image_raw</topic>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>5</update_rate>
      <camera>
        <camera_info_topic>camera/camera_info</camera_info_topic>
        <horizontal_fov>1.15</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>15</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  <gazebo reference="wheel_3_link">
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="wheel_4_link">
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="wheel_1_link">
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="wheel_2_link">
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
</robot>
