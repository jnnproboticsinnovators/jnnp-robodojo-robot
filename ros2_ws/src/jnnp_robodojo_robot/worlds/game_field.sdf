    <!-- 2: random time-based dynamic barrier. Boom arm hinged on the corridor wall:
         0 rad = closed (horizontal across corridor), 1.5708 rad = open (vertical).
         Commanded on gz topic "barrier/cmd" (bridged from ROS /barrier/cmd). -->
    <model name="dynamic_barrier">
      <pose>1.6089 4.2415 0 0 0 0</pose>
      <link name="post">
        <pose>0 0 0.1500 0 0 0</pose>
        <inertial><mass>5</mass><inertia><ixx>0.04</ixx><iyy>0.04</iyy><izz>0.002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.06 0.05 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.06 0.05 0.3</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>
      <link name="arm">
        <pose>0 0 0.2000 0 0 0</pose>
        <inertial><pose>0 0.2908 0 0 0 0</pose><mass>0.3</mass>
          <inertia><ixx>0.0085</ixx><iyy>0.0001</iyy><izz>0.0085</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><pose>0 0.2908 0 0 0 0</pose><geometry><box><size>0.04 0.5815 0.07</size></box></geometry></collision>
        <visual name="v"><pose>0 0.2908 0 0 0 0</pose><geometry><box><size>0.04 0.5815 0.07</size></box></geometry>
          <material><ambient>0.95 0.10 0.10 1</ambient><diffuse>0.95 0.10 0.10 1</diffuse></material></visual>
        <visual name="stripe1"><pose>0 0.1745 0 0 0 0</pose><geometry><box><size>0.042 0.08 0.072</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="stripe2"><pose>0 0.4071 0 0 0 0</pose><geometry><box><size>0.042 0.08 0.072</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      </link>
      <joint name="anchor" type="fixed"><parent>world</parent><child>post</child></joint>
      <joint name="hinge" type="revolute">
        <parent>post</parent><child>arm</child>
        <axis><xyz>1 0 0</xyz><limit><lower>0</lower><upper>1.6</upper></limit><dynamics><damping>0.1</damping></dynamics></axis>
      </joint>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>hinge</joint_name>
        <topic>barrier/cmd</topic>
        <use_velocity_commands>true</use_velocity_commands>
