<?xml version="1.0"?>
<sdf version="1.9">
  <model name="gamefield">
    <static>true</static>
    <link name="link">
      <pose>0.135886 6.443587 0.789877 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://gamefield/meshes/Gamefield.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
         <surface>
          <friction>
            <ode>
              <mu>1.0</mu> <!-- Adds wheel grip friction -->
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://gamefield/meshes/Gamefield.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.6 0.2 1</ambient>
          <diffuse>0.2 0.6 0.2 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
      <!-- Coloured floor zones, positions taken from the organisers' coloured field model
         (robot_2_description/meshes/gamefield.obj). Visual only: no effect on driving. -->
    <link name="zones">
      <visual name="zone_black">
        <pose>-0.8945 -1.1500 0.051 0 0 0</pose>
        <geometry><box><size>0.567 0.688 0.002</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="zone_red">
        <pose>-1.4725 -1.1560 0.051 0 0 0</pose>
        <geometry><box><size>0.567 0.688 0.002</size></box></geometry>
        <material><ambient>0.77 0.21 0.15 1</ambient><diffuse>0.77 0.21 0.15 1</diffuse></material>
      </visual>
      <visual name="zone_white">
        <pose>-1.9090 -0.5215 0.051 0 0 0</pose>
        <geometry><box><size>0.706 0.567 0.002</size></box></geometry>
        <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
